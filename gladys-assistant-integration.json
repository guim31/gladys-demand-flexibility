    },
    {
      "key": "event_ended",
      "label": {
        "en": "Event ended",
        "fr": "Événement terminé",
        "de": "Ereignis beendet",
        "es": "Evento terminado"
      },
      "description": {
        "en": "An event of this kind is over: back to normal consumption.",
        "fr": "Un événement de ce type est terminé : retour à la consommation normale.",
        "de": "Ein Ereignis dieser Art ist vorbei: zurück zum normalen Verbrauch.",
        "es": "Un evento de este tipo ha terminado: vuelta al consumo normal."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          }
        }
