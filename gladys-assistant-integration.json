            "de": "Minuten bis zum Beginn",
            "es": "Minutos hasta el inicio"
          }
        },
        {
          "key": "duration_minutes",
          "type": "number",
          "label": {
            "en": "Length (minutes)",
            "fr": "Durée (minutes)",
            "de": "Dauer (Minuten)",
            "es": "Duración (minutos)"
          }
        },
        {
          "key": "in_progress",
          "type": "number",
          "label": {
            "en": "In progress (1) or not (0)",
            "fr": "En cours (1) ou non (0)",
            "de": "Läuft (1) oder nicht (0)",
            "es": "En curso (1) o no (0)"
          }
        },
        {
          "key": "price",
          "type": "number",
          "label": {
