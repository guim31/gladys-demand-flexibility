  ],
  "scene_actions": [
    {
      "key": "get_next_event",
      "label": {
        "en": "Get the next event",
        "fr": "Lire le prochain événement",
        "de": "Nächstes Ereignis abrufen",
        "es": "Obtener el próximo evento"
      },
      "description": {
        "en": "The event in progress or the next one, for the following actions. Fails when none is announced.",
        "fr": "L'événement en cours ou le prochain, pour les actions suivantes. Échoue si aucun n'est annoncé.",
        "de": "Das laufende oder nächste Ereignis, für die folgenden Aktionen. Schlägt fehl, wenn keines angekündigt ist.",
        "es": "El evento en curso o el próximo, para las acciones siguientes. Falla si no hay ninguno anunciado."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          },
          "required": true
        }
      ],
      "outputs": [
