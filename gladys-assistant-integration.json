  "widgets": [
    {
      "key": "next_event",
      "label": {
        "en": "Next DFS event",
        "fr": "Prochain événement DFS",
        "de": "Nächstes DFS-Ereignis",
        "es": "Próximo evento DFS"
      },
      "description": {
        "en": "The event in progress or the next one, the upcoming ones and the last one.",
        "fr": "L'événement en cours ou le prochain, ceux à venir et le dernier.",
        "de": "Das laufende oder nächste Ereignis, die anstehenden und das letzte.",
        "es": "El evento en curso o el próximo, los siguientes y el último."
      },
      "icon": "zap",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          },
          "required": false
        },
        {
          "key": "show_upcoming",
          "type": "boolean",
          "label": {
            "en": "Show the upcoming events",
            "fr": "Afficher les événements à venir",
            "de": "Anstehende Ereignisse anzeigen",
            "es": "Mostrar los eventos próximos"
          },
          "required": false,
          "default": true
        },
        {
          "key": "show_last",
          "type": "boolean",
          "label": {
            "en": "Show the last event",
            "fr": "Afficher le dernier événement",
            "de": "Letztes Ereignis anzeigen",
            "es": "Mostrar el último evento"
          },
          "required": false,
          "default": true
        }
      ]
