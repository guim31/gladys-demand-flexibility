{
  "manifest_version": 1,
  "type": "device",
  "name": "NESO Demand Flexibility",
  "description": {
    "en": "Demand Flexibility Service events of the British grid (NESO): next event, alerts, widget.",
    "fr": "Événements Demand Flexibility du réseau britannique (NESO) : prochain événement, alertes, widget.",
    "de": "Demand-Flexibility-Ereignisse des britischen Netzes (NESO): nächstes Ereignis, Alarme, Widget.",
    "es": "Eventos Demand Flexibility de la red británica (NESO): próximo evento, alertas, widget."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-demand-flexibility:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-demand-flexibility/main/cover.png",
  "categories": ["energy"],
  "countries": ["GB"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Open data from NESO",
        "fr": "Les données ouvertes de NESO",
        "de": "Offene Daten von NESO",
        "es": "Datos abiertos de NESO"
      },
      "description": {
        "en": "The events of NESO's Demand Flexibility Service (behind the suppliers' saving sessions), read from the NESO Data Portal: no account, no key. Not affiliated with NESO.",
        "fr": "Les événements du Demand Flexibility Service de NESO (derrière les « saving sessions » des fournisseurs), lus sur le portail de données de NESO : ni compte ni clé. Sans lien avec NESO.",
        "de": "Die Ereignisse des Demand Flexibility Service von NESO (hinter den „Saving Sessions“ der Versorger), aus dem NESO-Datenportal: kein Konto, kein Schlüssel. Nicht mit NESO verbunden.",
        "es": "Los eventos del Demand Flexibility Service de NESO (detrás de las «saving sessions» de los proveedores), leídos en el portal de datos de NESO: sin cuenta ni clave. Sin relación con NESO."
      },
      "links": [
        {
          "url": "https://www.neso.energy/data-portal/demand-flexibility",
          "label": {
            "en": "NESO Data Portal",
            "fr": "Portail de données NESO",
            "de": "NESO-Datenportal",
            "es": "Portal de datos de NESO"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the device and feature names (fixed when a device is added) and of the texts sent to scenes.",
        "fr": "Langue des noms d'appareils et de fonctionnalités (figés à l'ajout d'un appareil) et des textes envoyés aux scènes.",
        "de": "Sprache der Geräte- und Funktionsnamen (beim Hinzufügen festgelegt) und der Texte für Szenen.",
        "es": "Idioma de los nombres de dispositivos y funciones (fijados al añadir un dispositivo) y de los textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "follow_down",
      "type": "boolean",
      "label": {
        "en": "Events to use less (turn-down)",
        "fr": "Événements pour consommer moins",
        "de": "Ereignisse zum Stromsparen",
        "es": "Eventos para consumir menos"
      },
      "description": {
        "en": "The usual events: paid to reduce consumption, as in the suppliers' saving sessions. One device.",
        "fr": "Les événements habituels : rémunérés pour réduire sa consommation, comme les « saving sessions » des fournisseurs. Un appareil.",
        "de": "Die üblichen Ereignisse: Geld fürs Senken des Verbrauchs, wie bei den „Saving Sessions“ der Versorger. Ein Gerät.",
        "es": "Los eventos habituales: remunerados por reducir el consumo, como las «saving sessions» de los proveedores. Un dispositivo."
      },
      "required": false,
      "default": true
    },
    {
      "key": "follow_up",
      "type": "boolean",
      "label": {
        "en": "Events to use more (turn-up)",
        "fr": "Événements pour consommer plus",
        "de": "Ereignisse zum Mehrverbrauch",
        "es": "Eventos para consumir más"
      },
      "description": {
        "en": "Rarer: paid to increase consumption when the grid has too much power. One device.",
        "fr": "Plus rares : rémunérés pour augmenter sa consommation quand le réseau a trop d'électricité. Un appareil.",
        "de": "Seltener: Geld fürs Erhöhen des Verbrauchs, wenn das Netz zu viel Strom hat. Ein Gerät.",
        "es": "Más raros: remunerados por aumentar el consumo cuando la red tiene demasiada electricidad. Un dispositivo."
      },
      "required": false,
      "default": false
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "event_announced",
      "label": {
        "en": "New event announced",
        "fr": "Nouvel événement annoncé",
        "de": "Neues Ereignis angekündigt",
        "es": "Nuevo evento anunciado"
      },
      "description": {
        "en": "NESO publishes a new event of this kind (usually around noon, for the same day).",
        "fr": "NESO publie un nouvel événement de ce type (en général vers midi, pour le jour même).",
        "de": "NESO veröffentlicht ein neues Ereignis dieser Art (meist gegen Mittag, für denselben Tag).",
        "es": "NESO publica un nuevo evento de este tipo (normalmente hacia mediodía, para el mismo día)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          }
        }
      ],
      "variables": [
        {
          "key": "day",
          "type": "string",
          "label": {
            "en": "Day",
            "fr": "Jour",
            "de": "Tag",
            "es": "Día"
          }
        },
        {
          "key": "start_time",
          "type": "string",
          "label": {
            "en": "Start time",
            "fr": "Heure de début",
            "de": "Startzeit",
            "es": "Hora de inicio"
          }
        },
        {
          "key": "end_time",
          "type": "string",
          "label": {
            "en": "End time",
            "fr": "Heure de fin",
            "de": "Endzeit",
            "es": "Hora de fin"
          }
        },
        {
          "key": "duration_minutes",
          "type": "number",
          "label": {
            "en": "Length (minutes)",
            "fr": "Durée (minutes)",
            "de": "Dauer (Minuten)",
            "es": "Duración (minutos)"
          }
        },
        {
          "key": "minutes_until",
          "type": "number",
          "label": {
            "en": "Minutes until it starts",
            "fr": "Minutes avant le début",
            "de": "Minuten bis zum Beginn",
            "es": "Minutos hasta el inicio"
          }
        },
        {
          "key": "price",
          "type": "number",
          "label": {
            "en": "Guaranteed price (£/MWh, 0: none)",
            "fr": "Prix garanti (£/MWh, 0 : aucun)",
            "de": "Garantierter Preis (£/MWh, 0: keiner)",
            "es": "Precio garantizado (£/MWh, 0: ninguno)"
          }
        }
      ]
    },
    {
      "key": "event_starting_soon",
      "label": {
        "en": "Event starts soon",
        "fr": "Événement imminent",
        "de": "Ereignis beginnt bald",
        "es": "El evento empieza pronto"
      },
      "description": {
        "en": "An event starts within the chosen time. Once per event and per time chosen.",
        "fr": "Un événement commence dans le délai choisi. Une fois par événement et par délai choisi.",
        "de": "Ein Ereignis beginnt innerhalb der gewählten Zeit. Einmal pro Ereignis und gewählter Zeit.",
        "es": "Un evento empieza dentro del plazo elegido. Una vez por evento y por plazo elegido."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          }
        },
        {
          "key": "lead",
          "type": "multi_select",
          "label": {
            "en": "Warn before",
            "fr": "Prévenir avant",
            "de": "Warnen vor",
            "es": "Avisar antes de"
          },
          "options": [
            {
              "value": "5",
              "label": {
                "en": "5 min",
                "fr": "5 min",
                "de": "5 Min.",
                "es": "5 min"
              }
            },
            {
              "value": "15",
              "label": {
                "en": "15 min",
                "fr": "15 min",
                "de": "15 Min.",
                "es": "15 min"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 min",
