          "key": "day",
          "type": "string",
          "label": {
            "en": "Day",
            "fr": "Jour",
            "de": "Tag",
            "es": "Día"
          }
        },
        {
          "key": "start_time",
          "type": "string",
          "label": {
            "en": "Start time",
            "fr": "Heure de début",
